# Postgres on Neon, same setup as The Doer Life. In Vercel: Storage → Neon → connect, which
# fills these in. DATABASE_URL is the pooled connection; migrations use the unpooled one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Random secret that signs sign-in sessions. Required in production.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Gemini, for evaluations, the agents, Copilot and the weekly briefing.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_CAREFUL_MODEL=gemini-3.5-flash

# Random secret Vercel Cron sends when it runs the Monday briefing.
CRON_SECRET=

# The site's own address (optional on Vercel, where it's known automatically).
APP_URL=

# Local testing only: canned AI answers so you can click through without a Gemini key.
# AI_FAKE=1
